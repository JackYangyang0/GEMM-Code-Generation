          "local_checks": [
            "cpu_memory.pack_buffer_scope != null"
          ],
          "next_subphase": "CPUPacking.PrefetchPolicy"
        },
        {
          "subphase_id": "CPUPacking.PrefetchPolicy",
          "order": 3,
          "optional": true,
          "purpose": "Choose optional software prefetch policy.",
          "allowed_strategy_ids": [
            "CPU.Memory.Prefetch.Disabled",
            "CPU.Memory.Prefetch.BPanel",
            "CPU.Memory.Prefetch.ABPanel"
          ],
          "requires_fields": [
            "cpu_memory.pack_buffer_scope"
          ],
          "provides_fields": [
            "cpu_memory.prefetch"
          ],
          "local_checks": [
            "cpu_memory.prefetch != null"
          ],
          "next_subphase": "CPUPacking.StageVerification"
        }
      ],
      "stage_verification": {
        "stage_id": "CPUPacking.StageVerification",
        "required_fields": [
          "cpu_memory.pack_a",
          "cpu_memory.pack_b",
          "cpu_memory.pack_layout",
          "cpu_memory.pack_buffer_scope"
        ],
        "predicates": [
          "cpu_memory.pack_a != null",
          "cpu_memory.pack_b != null",
          "cpu_memory.pack_layout != null",
          "cpu_memory.pack_buffer_scope != null"
        ]
      },
      "stage_id": "CPUPacking",
      "subphase_order": [
        "CPUPacking.PanelPackingPolicy",
        "CPUPacking.PackBufferOwnership",
        "CPUPacking.PrefetchPolicy",
        "CPUPacking.StageVerification"
      ]
    },
