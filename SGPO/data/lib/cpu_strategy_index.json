{
  "index_name": "SGPO CPU C Strategy Index",
  "index_version": "3.2-openblas-style-cpu-gemm-throughput-boundary-relaxed",
  "target": {
    "backend": "cpu",
    "language": "c",
    "default_profile": "cpu_throughput",
    "default_stage_order": [
      "CPUTiling",
      "CPUPacking",
      "CPUMicroKernel",
      "CPUVectorization",
      "CPULoopSchedule",
      "CPUParallelization",
      "CPUCompiler",
      "CPUEpilogue"
    ]
  },
  "stage_order": [
    "CPUTiling",
    "CPUPacking",
    "CPUMicroKernel",
    "CPUVectorization",
    "CPULoopSchedule",
    "CPUParallelization",
    "CPUCompiler",
    "CPUEpilogue"
  ],
  "global_selection_rules": [
    "Use this index only when target.backend = cpu.",
    "Generate ordinary C code only; CUDA strategies are forbidden.",
    "CPU GEMM construction order is tiling -> packing -> micro-kernel -> vectorization -> loop schedule -> parallelization -> compiler flags -> epilogue.",
    "Explicit SIMD/FMA micro-kernels require scalar tail handling and a scalar fallback path.",
    "Packed A/B panels must preserve row-major NN GEMM semantics.",
    "Explicit CPU SIMD lanes must map to contiguous N outputs; A is scalar-broadcast and K is reduced sequentially.",
    "OpenMP plus packed panels requires thread-private or tile-private A/B packing buffers.",
    "Packed B panel layout must be consumed consistently as K-major panel data for row-major NN GEMM.",
    "After correctness passes, throughput_exploration may emit full-tile fast paths, but must keep scalar cleanup for M/N/K tails.",
    "OpenBLAS-style CPU code must materialize macro-kernel, pack kernels, micro-kernel, and epilogue as a closed dataflow.",
    "SIMD full-tile fast path may remove inner boundary checks only when scalar cleanup covers residual rows, columns, and K tails."
  ],
  "stages": {
    "CPUTiling": {
      "description": "Choose L2, L1, and register tile sizes for CPU GEMM.",
      "subphases": [
        {
          "subphase_id": "CPUTiling.L2BlockSelection",
          "order": 1,
          "optional": false,
          "purpose": "Choose outer M/N/K tile whose A/B/C working set fits the L2 cache budget.",
          "allowed_strategy_patterns": [
            "CPU.Tiling.L2Block.*"
          ],
          "allowed_strategy_ids": [
            "CPU.Tiling.L2Block.128x128x128",
            "CPU.Tiling.L2Block.192x128x128",
            "CPU.Tiling.L2Block.256x128x128"
          ],
          "requires_fields": [
            "problem.M",
            "problem.N",
            "problem.K",
            "hardware.cpu_cache.l2_cache_bytes"
          ],
          "provides_fields": [
            "cpu_tiling.l2_block_m",
            "cpu_tiling.l2_block_n",
            "cpu_tiling.l2_block_k",
            "cpu_resource.l2_working_set_bytes"
          ],
          "local_checks": [
            "cpu_tiling.l2_block_m != null",
            "cpu_tiling.l2_block_n != null",
            "cpu_tiling.l2_block_k != null",
            {
              "id": "CPU_L2_WORKING_SET_FITS",
              "op": "le",
              "lhs": "cpu_resource.l2_working_set_bytes",
              "rhs_field": "cpu_resource.l2_budget_bytes"
            }
          ],
          "next_subphase": "CPUTiling.L1BlockSelection"
        },
        {
          "subphase_id": "CPUTiling.L1BlockSelection",
          "order": 2,
          "optional": false,
          "purpose": "Choose inner tile whose A/B/C live working set fits the L1 data cache budget.",
          "allowed_strategy_patterns": [
            "CPU.Tiling.L1Block.*"
          ],
          "allowed_strategy_ids": [
            "CPU.Tiling.L1Block.16x32x64",
            "CPU.Tiling.L1Block.32x32x64",
            "CPU.Tiling.L1Block.32x64x64"
          ],
          "requires_fields": [
            "cpu_tiling.l2_block_m",
            "cpu_tiling.l2_block_n",
            "cpu_tiling.l2_block_k",
            "hardware.cpu_cache.l1_data_cache_bytes"
          ],
          "provides_fields": [
            "cpu_tiling.l1_block_m",
            "cpu_tiling.l1_block_n",
            "cpu_tiling.l1_block_k",
            "cpu_resource.l1_working_set_bytes"
          ],
          "local_checks": [
            "cpu_tiling.l1_block_m != null",
            "cpu_tiling.l1_block_n != null",
            "cpu_tiling.l1_block_k != null",
            {
              "id": "CPU_L1_WORKING_SET_FITS",
              "op": "le",
              "lhs": "cpu_resource.l1_working_set_bytes",
              "rhs_field": "cpu_resource.l1_budget_bytes"
            }
          ],
          "next_subphase": "CPUTiling.RegisterBlockSelection"
        },
        {
          "subphase_id": "CPUTiling.RegisterBlockSelection",
          "order": 3,
          "optional": false,
          "purpose": "Choose scalar/register accumulator tile shape.",
          "allowed_strategy_ids": [
            "CPU.Tiling.RegisterBlock.2x4",
            "CPU.Tiling.RegisterBlock.4x4",
            "CPU.Tiling.RegisterBlock.4x8"
          ],
          "requires_fields": [
            "cpu_tiling.l1_block_m",
            "cpu_tiling.l1_block_n"
          ],
          "provides_fields": [
            "cpu_tiling.register_m",
            "cpu_tiling.register_n",
            "cpu_resource.register_accumulator_count"
          ],
          "local_checks": [
            "cpu_tiling.register_m != null",
            "cpu_tiling.register_n != null",
            {
              "id": "CPU_REGISTER_BLOCK_REASONABLE",
              "op": "le",
              "lhs": "cpu_resource.register_accumulator_count",
              "rhs_value": 32
            }
          ],
          "next_subphase": "CPUTiling.StageVerification"
        }
      ],
      "stage_verification": {
        "stage_id": "CPUTiling.StageVerification",
        "required_fields": [
          "cpu_tiling.l2_block_m",
          "cpu_tiling.l2_block_n",
          "cpu_tiling.l2_block_k",
          "cpu_tiling.l1_block_m",
          "cpu_tiling.l1_block_n",
          "cpu_tiling.l1_block_k",
          "cpu_tiling.register_m",
          "cpu_tiling.register_n",
          "cpu_resource.l2_working_set_bytes",
          "cpu_resource.l1_working_set_bytes"
        ],
        "predicates": [
          {
            "id": "CPU_L2_WORKING_SET_FITS",
            "op": "le",
            "lhs": "cpu_resource.l2_working_set_bytes",
            "rhs_field": "cpu_resource.l2_budget_bytes"
          },
          {
            "id": "CPU_L1_WORKING_SET_FITS",
            "op": "le",
            "lhs": "cpu_resource.l1_working_set_bytes",
            "rhs_field": "cpu_resource.l1_budget_bytes"
          },
          {
            "id": "CPU_REGISTER_BLOCK_REASONABLE",
            "op": "le",
            "lhs": "cpu_resource.register_accumulator_count",
            "rhs_value": 32
          }
        ]
      },
      "stage_id": "CPUTiling",
      "subphase_order": [
        "CPUTiling.L2BlockSelection",
        "CPUTiling.L1BlockSelection",
        "CPUTiling.RegisterBlockSelection",
        "CPUTiling.StageVerification"
      ]
    },
    "CPUPacking": {
      "description": "Choose A/B packing and optional prefetch policy before micro-kernel construction.",
