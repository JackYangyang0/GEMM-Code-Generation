  "strategy_dependency_notes": [
    "Packing must be selected before SIMD micro-kernel construction.",
    "Micro-kernel shape determines which vectorization policy is legal.",
    "OpenMP strategies should be paired with CPU.Compiler.NativeO3OpenMP or CPU.Compiler.MSVC.AVX2OpenMP.",
    "Compiler flags are explicit strategies so generated code and verifier use matching assumptions.",
    "OpenMP packed-panel code must use thread-private or tile-private buffers before any parallel tile schedule is selected.",
    "Intel SIMD micro-kernels must use N-lane accumulator vectors: broadcast A scalar, load contiguous B panel/N columns, and reduce K sequentially.",
    "OpenBLASPanelMajor is a portable structural strategy inspired by OpenBLAS/QiMeng drivers; ISA-specific compute remains backend-specific.",
    "Throughput CPU paths may relax inner full-tile boundary checks only when CPU.TailKernel.FullTileFastPathScalarCleanup is present.",
    "CPU.MacroKernel.OpenBLASStyle.PanelDriver must appear before OpenBLASPanelMajor loop scheduling.",
    "PackA/PackB implementation strategies are separate from selecting packed-memory flags; code generation must emit real copy loops."
  ],
  "requires": {
    "CPU.MacroKernel.OpenBLASStyle.PanelDriver": [
      {
        "mode": "all",
        "strategies": [
          "CPU.Memory.PackBuffer.ThreadPrivate"
        ],
        "required_state": {
          "cpu_memory.pack_b": true
        }
      }
    ],
    "CPU.LoopOrder.OpenBLASPanelMajor": [
